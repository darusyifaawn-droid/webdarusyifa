rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "darusyifa.awn@gmail.com" ||
        request.auth.token.email == "admin@darusyifa.com" ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    function isGuru() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'guru';
    }

    function isSiswa() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'siswa';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ===============================================================
    // GLOBAL RULES
    // ===============================================================
    // Remove the global deny if false to avoid any confusion, 
    // and rely on explicit collection-level security.
    
    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Rules for Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); // Allow self-creation or admin creation
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin() || isGuru());
      allow delete: if isAdmin();
    }

    // Rules for Progress
    match /progress/{progressId} {
      allow read: if isSignedIn() && (
        isAdmin() || isGuru() || resource.data.studentId == request.auth.uid
      );
      allow write: if isAdmin() || isGuru();
    }

    // Rules for Attendance
    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (
        isAdmin() || isGuru() || resource.data.studentId == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isAdmin() || isGuru();
      allow delete: if isAdmin();
    }

    // Rules for Payments
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        isAdmin() || resource.data.studentId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        isAdmin() || request.resource.data.studentId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // Rules for Subjects
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isGuru();
    }

    // Rules for Hafalan Materials
    match /hafalan_materials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isGuru();
    }

    // Rules for Hafalan Progress
    match /hafalan_progress/{progressId} {
      allow read: if isSignedIn() && (
        isAdmin() || isGuru() || resource.data.studentId == request.auth.uid
      );
      allow write: if isAdmin() || isGuru() || (isSignedIn() && (
        (request.resource != null && request.resource.data.studentId == request.auth.uid) ||
        (resource != null && resource.data.studentId == request.auth.uid)
      ));
    }

    // Announcements
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Settings
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Classes
    match /classes/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Kaldik
    match /kaldik/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Materials
    match /materials/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isGuru();
    }

    // Exams
    match /exams/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Iuran Categories
    match /iuran_categories/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
