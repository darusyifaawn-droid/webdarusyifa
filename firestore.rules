rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'darusyifa.awn@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    function isGuru() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().role == 'guru';
    }

    function isSiswa() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().role == 'siswa';
    }

    // Rules for Users
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin() || isGuru();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Rules for Hafalan
    match /hafalan_materials/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isGuru();
    }

    match /hafalan_progress/{id} {
      allow read: if isSignedIn() && (
        isAdmin() || isGuru() || (isSiswa() && request.auth.uid == resource.data.studentId)
      );
      allow create: if isSignedIn() && (
        isAdmin() || isGuru() || (isSiswa() && request.auth.uid == request.resource.data.studentId)
      );
      allow update: if isSignedIn() && (
        isAdmin() || isGuru() || (isSiswa() && request.auth.uid == resource.data.studentId)
      );
      allow delete: if isAdmin() || isGuru();
    }

    // Rules for General Collections
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /classes/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /subjects/{id} {
      allow read: if isSignedIn();
      allow write: if isGuru() || isAdmin();
    }

    match /kaldik/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /materials/{id} {
      allow read: if isSignedIn();
      allow write: if isGuru() || isAdmin();
    }

    match /exams/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /iuran_categories/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /payments/{id} {
      allow read: if isSignedIn() && (isAdmin() || (isSiswa() && request.auth.uid == resource.data.studentId));
      allow create: if isSignedIn() && (isAdmin() || (isSiswa() && request.resource.data.studentId == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    match /progress/{id} {
      allow read: if isSignedIn() && (isAdmin() || isGuru() || (isSiswa() && request.auth.uid == resource.data.studentId));
      allow write: if isAdmin() || isGuru();
    }

    match /attendance/{id} {
      allow read: if isSignedIn() && (isAdmin() || isGuru() || (isSiswa() && request.auth.uid == resource.data.studentId));
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isGuru();
    }
  }
}
