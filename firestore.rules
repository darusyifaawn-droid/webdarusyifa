rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Fields: name (string), email (string), role (string: admin|guru|siswa)
    //
    // Collection: progress
    // Fields: studentId (string), teacherId (string), description (string), score (number), date (string)
    //
    // Collection: attendance
    // Fields: studentId (string), date (string), timestamp (timestamp), location (map), status (string)
    // ===============================================================

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isRole(role) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      let isBootstrapAdmin = request.auth.token.email == "darusyifa.awn@gmail.com" && isEmailVerified();
      return isBootstrapAdmin || isRole('admin');
    }

    function isGuru() {
      return isRole('guru');
    }

    function isSiswa() {
      return isRole('siswa');
    }

    // Rules for Users
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin() || isGuru();
      
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Rules for Progress
    match /progress/{progressId} {
      allow read: if isSignedIn() && (
        (isSiswa() && request.auth.uid == resource.data.studentId) || 
        isGuru() || 
        isAdmin()
      );
      
      allow create: if isGuru() || isAdmin();
      allow update: if isGuru() || isAdmin();
      allow delete: if isGuru() || isAdmin();
    }

    // Rules for Attendance
    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (
        (isSiswa() && request.auth.uid == resource.data.studentId) || 
        isGuru() || 
        isAdmin()
      );
      
      allow create: if isSignedIn() && (isSiswa() || isGuru());
      allow update: if isGuru() || isAdmin();
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.studentId || isAdmin());
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Classes (Kategori Kelas)
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Subjects (Mata Pelajaran)
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isGuru() || isAdmin();
    }

    // Kaldik (Kalender Pendidikan)
    match /kaldik/{kaldikId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Materials (Materi / Bahan Ajar)
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isGuru() || isAdmin();
    }

    // Payments (Financial History)
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        (isSiswa() && request.auth.uid == resource.data.studentId)
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        (isSiswa() && request.resource.data.studentId == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }
    // Rules for Hafalan Progress
    match /hafalan_progress/{progressId} {
      allow read: if isSignedIn() && (
        (isSiswa() && request.auth.uid == resource.data.studentId) || 
        isGuru() || 
        isAdmin()
      );
      
      allow create: if isSignedIn() && (
        isGuru() || 
        isAdmin() || 
        (isSiswa() && request.auth.uid == request.resource.data.studentId)
      );
      
      allow update: if isSignedIn() && (
        isGuru() || 
        isAdmin() || 
        (isSiswa() && request.auth.uid == resource.data.studentId && request.auth.uid == request.resource.data.studentId)
      );
      
      allow delete: if isAdmin() || isGuru();
    }
  }
}
