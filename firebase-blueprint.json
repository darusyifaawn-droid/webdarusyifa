{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["siswa", "guru", "admin"] },
        "photoURL": { "type": "string" },
        "savings": { "type": "number" },
        "arrears": { "type": "number" },
        "arrears_details": { "type": "array" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Academic subjects (Mata Pelajaran)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "teacherId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "StudentProgress": {
      "title": "StudentProgress",
      "description": "Daily student progress",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "score": { "type": "number" },
        "category": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["studentId", "teacherId", "date", "description"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Financial transaction history",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "type": { "type": "string", "enum": ["tabungan", "iuran"] },
        "description": { "type": "string" },
        "adminId": { "type": "string" }
      },
      "required": ["studentId", "amount", "date", "type"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Student attendance",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string" },
        "photo": { "type": "string" },
        "location": { "type": "object" },
        "timestamp": { "type": "object" }
      },
      "required": ["studentId", "date", "status"]
    },
    "HafalanMaterial": {
      "title": "HafalanMaterial",
      "description": "Memorization modules",
      "type": "object",
      "properties": {
        "kelas": { "type": "string" },
        "kategori": { "type": "string" },
        "judul": { "type": "string" },
        "arab": { "type": "string" },
        "latin": { "type": "string" },
        "terjemahan": { "type": "string" },
        "urutan": { "type": "number" },
        "createdAt": { "type": "object" }
      },
      "required": ["kelas", "kategori", "judul", "urutan"]
    },
    "HafalanCategory": {
      "title": "HafalanCategory",
      "description": "Custom categories for hafalan / memorization materials",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "object" }
      },
      "required": ["name"]
    },
    "FinanceTransaction": {
      "title": "FinanceTransaction",
      "description": "General financial ledger for incomes and expenses",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "adminId": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["amount", "date", "type", "description"]
    },
    "SalarySlip": {
      "title": "SalarySlip",
      "description": "Teacher payroll records and salary slips",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "teacherEmail": { "type": "string" },
        "teacherNip": { "type": "string" },
        "teacherJabatan": { "type": "string" },
        "assignedClass": { "type": "string" },
        "bulan": { "type": "string" },
        "tahun": { "type": "number" },
        "periode": { "type": "string" },
        "tanggalTerbit": { "type": "string", "format": "date" },
        "gajiPokok": { "type": "number" },
        "tunjanganJabatan": { "type": "number" },
        "tunjanganWaliKelas": { "type": "number" },
        "tunjanganTransport": { "type": "number" },
        "tunjanganMakan": { "type": "number" },
        "tunjanganKehadiran": { "type": "number" },
        "insentifBonus": { "type": "number" },
        "rincianTunjanganLain": { "type": "array" },
        "totalPenerimaan": { "type": "number" },
        "potonganBpjs": { "type": "number" },
        "potonganKoperasi": { "type": "number" },
        "potonganAbsen": { "type": "number" },
        "potonganPinjaman": { "type": "number" },
        "rincianPotonganLain": { "type": "array" },
        "totalPotongan": { "type": "number" },
        "gajiBersih": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Diterbitkan", "Dibayarkan"] },
        "metodePembayaran": { "type": "string" },
        "catatan": { "type": "string" },
        "namaKepsek": { "type": "string" },
        "nipKepsek": { "type": "string" },
        "qrVerificationCode": { "type": "string" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["teacherId", "teacherName", "bulan", "tahun", "totalPenerimaan", "totalPotongan", "gajiBersih"]
    },
    "CashDeposit": {
      "title": "CashDeposit",
      "description": "Cash handover deposits from treasurer to principal or foundation",
      "type": "object",
      "properties": {
        "depositNumber": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "periodType": { "type": "string", "enum": ["Harian", "Mingguan", "Bulanan", "Custom"] },
        "depositType": { "type": "string", "enum": ["Tabungan", "Iuran Bulanan", "Uang Kegiatan", "PPDB / Pendaftaran", "Penjualan Buku / Seragam", "Lainnya"] },
        "source": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "treasurerId": { "type": "string" },
        "treasurerName": { "type": "string" },
        "treasurerNip": { "type": "string" },
        "treasurerTitle": { "type": "string" },
        "treasurerVerified": { "type": "boolean" },
        "treasurerVerifiedAt": { "type": "string" },
        "receiverId": { "type": "string" },
        "receiverName": { "type": "string" },
        "receiverNip": { "type": "string" },
        "receiverTitle": { "type": "string" },
        "principalVerified": { "type": "boolean" },
        "principalVerifiedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["menunggu_verifikasi_bendahara", "menunggu_verifikasi_kepsek", "disahkan", "ditolak"] },
        "rejectionReason": { "type": "string" },
        "qrVerificationCode": { "type": "string" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["depositNumber", "date", "amount", "depositType", "status", "treasurerName", "receiverName"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "User profiles" },
    "/subjects/{subjectId}": { "schema": "Subject", "description": "Academic subject categories" },
    "/progress/{progressId}": { "schema": "StudentProgress", "description": "Global student progress reports" },
    "/attendance/{attendanceId}": { "schema": "Attendance", "description": "Global attendance records" },
    "/payments/{paymentId}": { "schema": "Payment", "description": "Payment and savings history" },
    "/hafalan_materials/{materialId}": { "schema": "HafalanMaterial", "description": "Memorization modules" },
    "/hafalan_categories/{categoryId}": { "schema": "HafalanCategory", "description": "Custom categories for hafalan materials" },
    "/hafalan_progress/{progressId}": { "description": "Student memorization progress" },
    "/finance_transactions/{transactionId}": { "schema": "FinanceTransaction", "description": "Cash flow records" },
    "/salary_slips/{slipId}": { "schema": "SalarySlip", "description": "Teacher salary slips" },
    "/cash_deposits/{depositId}": { "schema": "CashDeposit", "description": "Treasurer cash deposits to principal and foundation" }
  }
}
